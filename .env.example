# Copy this file to .env and fill in your Razorpay TEST MODE keys.
# Get them free from: Razorpay Dashboard -> Settings -> API Keys
# (make sure the "Test Mode" toggle is ON before generating keys)
#
# If left blank, the backend runs in MOCK mode automatically --
# everything else (cart, guardrails, audit trail, MCP tools) still
# works fully, only the payment link becomes a fake mock URL.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# REQUIRED (unlike the keys above) -- signs/verifies AI-agent session
# warrants (POST /session/agent) AND re-verifies them at payment time
# (policy.py, POST /agent/pay). Without this set, no AI agent can ever
# get a session, so the whole AI-buyer half of the demo can't run --
# there is no blank-means-mock fallback for this one. The value below
# is a demo-only secret, safe to keep as-is for local test-mode use;
# generate your own with `python -c "import secrets;
# print(secrets.token_hex(24))"` for anything beyond a local demo.
AGENT_WARRANT_SECRET=136bca1db1e503c3489110a366061b52461c844ddc86b9fe

# Identifies this merchant inside a signed warrant -- must match on
# both the side issuing warrants and the side verifying them. No need
# to change this for the demo.
MERCHANT_ID=demo_merchant

# REQUIRED (like AGENT_WARRANT_SECRET above, unlike the Razorpay keys)
# -- confirms a payment actually completed, not just that a payment
# link/order was created. Verifies POST /webhook/razorpay (where a
# real Razorpay deployment would call) AND POST /demo/simulate-capture
# (this demo's local stand-in, since there's no public URL for
# Razorpay to call) through the exact same code path -- see
# webhooks.py. For a REAL deployment, get this from: Razorpay
# Dashboard -> Settings -> Webhooks -> (create/select a webhook
# pointed at POST /webhook/razorpay) -> Secret. The demo value below
# is safe to keep as-is for local test-mode use.
RAZORPAY_WEBHOOK_SECRET=b62aca71df193bd8d7039a2987dc97bb56e2ca6468731bb2

# Optional -- lets the upsell suggestion's one-line reason be written
# by an LLM (Groq's free tier, Llama-hosted), tailored to what's
# actually in the cart, instead of the fixed string in catalog.py's
# UPSELL_MAP. Get a free key (no credit card) from:
# https://console.groq.com/keys
#
# If left blank (or the call fails/times out), the fixed string is
# used silently -- which product gets suggested never changes, and
# checkout is never affected either way.
GROQ_API_KEY=
